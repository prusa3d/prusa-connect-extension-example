{
  "name": "hello-ui",
  "version": "1.0.0",
  "private": true,
  "description": "The browser half of the hello module, on the component library, built into the bundle the host serves.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check": "pnpm run lint && pnpm run format:check && pnpm run check:svelte"
  },
  "dependencies": {
    "@prusa/connect": "0.0.1",
    "@prusa/connect-ui": "0.0.1",
    "hello-client": "link:../client"
  },
  "devDependencies": {
    "@prusa/frontend-standards": "0.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.1",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
